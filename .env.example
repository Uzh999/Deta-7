# ---------------------------------------------------------------------------
# Premium Detailing — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Client (exposed in the browser bundle — use a domain-restricted key) ---

# MapTiler API key used by the Location section to render the studio map.
# Get one at https://cloud.maptiler.com/account/keys/
# Restrict it to your production domain: the key ships in the client bundle.
# If it is absent the site still builds and a graceful map fallback is shown.
VITE_MAPTILER_KEY=your_maptiler_key_here

# --- Server (used only by the /api/leads serverless function) ---

# Telegram bot that receives new leads.
# Create via @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotTokenReplaceMe

# Comma-separated chat IDs the lead notification is sent to.
# Required — the endpoint returns 500 without it.
TELEGRAM_CHAT_IDS=111111111,222222222

# --- Email notifications (optional) ---
# If any of the three below is missing, email delivery is skipped silently
# and Telegram delivery still works.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_example_resend_api_key

# Inbox that receives the lead notification.
ADMIN_EMAIL=owner@example.com

# Verified sender address in Resend.
FROM_EMAIL=noreply@example.com
